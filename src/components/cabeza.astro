---
import logo from '../assets/images/ico_vallejo.png';
---

<header class="sticky top-0 z-50 bg-aduni-void/90 backdrop-blur-md border-b border-white/10 overflow-hidden">
  <div class="container mx-auto px-4 py-3 flex flex-col lg:flex-row items-center justify-between gap-4">
    
    <div class="flex items-center space-x-3">
      <div class="relative group">
        <div class="absolute inset-0 bg-aduni-crimson blur-lg opacity-20 group-hover:opacity-40 transition-opacity"></div>
        <img 
          src={logo.src} 
          alt="Logo Aduni" 
          class="w-12 h-12 md:w-16 md:h-16 relative z-10 transition-transform duration-500 group-hover:rotate-12"
        />
      </div>
      
      <div class="text-left">
        <h1 class="text-xl md:text-2xl font-black tracking-tighter leading-none flex items-center gap-1">
          <span class="text-aduni-crimson">A</span>
          <span class="text-white">CADEMIA</span>
          <span class="text-aduni-crimson ml-1">A</span>
          <span class="text-white">DUNI</span>
          <span class="text-aduni-neon-blue font-extrabold ml-1">VALLEJO</span>
        </h1>
        <p class="text-[9px] uppercase tracking-[0.3em] text-aduni-ice font-bold opacity-70">
          Nosotros Aseguramos Tu Vacante
        </p>
      </div>
    </div>

    <nav class="w-full lg:w-auto">
      <ul class="flex flex-wrap justify-center gap-2 md:gap-4 font-bold text-[10px] md:text-xs uppercase tracking-widest">
        <li>
          <a href="#inicio" class="nav-link">Conócenos</a>
        </li>
        <li>
          <a href="#modalidades" class="nav-link">Modalidades</a>
        </li>
        <li>
          <a href="https://sistema.adunivallejoacademi.com">
          SISTEMA ACADEMICO
          </a>
        <li>
          <a href="#galeria" class="nav-link">Cachimbos</a>
        </li>
        <li>
          <a href="#ubicacion" class="nav-link text-aduni-neon-blue">Ubicación</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="absolute bottom-0 left-0 h-[1px] w-full bg-gradient-to-r from-transparent via-aduni-crimson to-transparent scan-line"></div>
</header>

<style>
  @reference "../styles/global.css";

  .nav-link {
    @apply relative px-3 py-2 text-aduni-ice hover:text-white transition-colors duration-300;
  }

  /* Línea animada más segura para móviles */
  .scan-line {
    animation: scan 4s linear infinite;
    background-size: 200% 100%;
  }

  @keyframes scan {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }

  /* Evita que el texto se rompa en palabras feas */
  h1 {
    white-space: nowrap;
  }
</style>
