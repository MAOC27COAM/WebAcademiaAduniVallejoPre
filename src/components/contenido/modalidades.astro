---
import pre_u from '../../assets/images/img_ordinario.jpg';
import primera from '../../assets/images/img_primera.jpg';
import coar from '../../assets/images/img_coar.jpg';
import secundaria from '../../assets/images/img_secundaria.png';
import beca18 from '../../assets/images/img_beca18.jpg';
import primaria from '../../assets/images/img_primaria.jpg';


const modalidades = [
  { titulo: "Pre-u", img: pre_u.src},
  { titulo: "Primera Opción", img: primera.src},
  { titulo: "COAR", img: coar.src },
  { titulo: "Beca 18", img: beca18.src},
  { titulo: "Secundaria", img: secundaria.src},
  { titulo: "Primaria", img: primaria.src },
];
---

<section id="modalidades" class="py-20 bg-white overflow-hidden">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-black text-blue-900 uppercase">Nuestras Modalidades</h2>
      <p class="text-gray-500 mt-2">Desliza para conocer nuestros programas especializados</p>
    </div>

    <div class="swiper modalidadesSwiper">
      <div class="swiper-wrapper">
        {modalidades.map((item) => (
          <div class="swiper-slide">
            <div class="relative group h-80 rounded-2xl overflow-hidden shadow-lg border-2 border-transparent hover:border-red-600 transition-all duration-300">
              
              <div class="absolute inset-0 bg-blue-800">
                <img 
                  src={item.img} 
                  alt={item.titulo} 
                  class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-blue-900/30 group-hover:bg-transparent transition-colors duration-300"></div>
              </div>
              
              <div class="absolute inset-0 bg-gradient-to-t from-blue-900 via-transparent to-transparent flex flex-col justify-end p-6">
                <h3 class="text-white font-bold text-xl uppercase drop-shadow-lg">{item.titulo}</h3>
                <div class="w-10 h-1 bg-yellow-400 mt-2 group-hover:w-full transition-all duration-300"></div>
              </div>

            </div>
          </div>
        ))}
      </div>
      
      <div class="pt-10">
        <div class="swiper-pagination !static"></div>
      </div>
    </div>
  </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';

  new Swiper('.modalidadesSwiper', {
    modules: [Navigation, Pagination, Autoplay],
    slidesPerView: 1,
    spaceBetween: 20,
    loop: true,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
    breakpoints: {
      640: { slidesPerView: 2 },
      1024: { slidesPerView: 3 },
      1280: { slidesPerView: 4 },
    },
  });
</script>

<style>
 
  .swiper-pagination-bullet-active {
    background-color: #dc2626 !important;
  }
</style>