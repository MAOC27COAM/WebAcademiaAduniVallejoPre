import estudiante_3 from "../../assets/images/cachimbos/cachimbo2025_3.jpeg"
import estudiante_4 from "../../assets/images/cachimbos/cachimbo2025_4.jpeg"
import estudiante_5 from "../../assets/images/cachimbos/cachimbo2025_5.jpeg"
import estudiante_6 from "../../assets/images/cachimbos/cachimbo2025_6.jpeg"
import estudiante_7 from "../../assets/images/cachimbos/cachimbo2025_7.jpeg"
import estudiante_8 from "../../assets/images/cachimbos/cachimbo2025_8.jpeg"
import estudiante_9 from "../../assets/images/cachimbos/cachimbo2025_9.jpeg"
import estudiante_10 from "../../assets/images/cachimbos/cachimbo2025_10.jpeg"
import estudiante_11 from "../../assets/images/cachimbos/cachimbo2025_11.jpeg"
import estudiante_12 from "../../assets/images/cachimbos/cachimbo2025_12.jpeg"
import estudiante_13 from "../../assets/images/cachimbos/cachimbo2025_13.jpeg"
import estudiante_14 from "../../assets/images/cachimbos/cachimbo2025_14.jpeg"
import estudiante_15 from "../../assets/images/cachimbos/cachimbo2025_15.jpeg"
import estudiante_16 from "../../assets/images/cachimbos/cachimbo2025_16.jpeg"
import estudiante_17 from "../../assets/images/cachimbos/cachimbo2025_17.jpeg"

const ingresantes = [
  { universidad: "UNAJMA", img: estudiante_1.src },
  { universidad: "UNAJMA", img: estudiante_2.src },
  { universidad: "UNAJMA", img: estudiante_3.src },
  { universidad: "UNAJMA", img: estudiante_4.src },
  { universidad: "UNAJMA", img: estudiante_5.src },
  { universidad: "UNAJMA", img: estudiante_6.src },
  { universidad: "UNAJMA", img: estudiante_7.src },
  { universidad: "UNAJMA", img: estudiante_8.src },
  { universidad: "UNAJMA", img: estudiante_9.src },
  { universidad: "UNAJMA", img: estudiante_10.src },
  { universidad: "UNAJMA", img: estudiante_11.src },
  { universidad: "UNAJMA", img: estudiante_12.src },
  { universidad: "UNAJMA", img: estudiante_13.src },
  { universidad: "UNAJMA", img: estudiante_14.src },
  { universidad: "UNAJMA", img: estudiante_15.src },
  { universidad: "UNAJMA", img: estudiante_16.src },
  { universidad: "UNAJMA", img: estudiante_17.src },
  
];

// Duplicamos el array para crear el efecto infinito sin saltos

const doubleIngresantes = [...ingresantes, ...ingresantes];

---



<section id="galeria" class="py-16 bg-slate-900 overflow-hidden">

  <div class="container mx-auto px-4 mb-10">

    <h2 class="text-3xl md:text-4xl font-black text-white uppercase border-l-8 border-red-600 pl-4">

      Nuestros <span class="text-red-600">Resultados</span>

    </h2>

    <p class="text-slate-400 mt-2">Orgullosos de nuestros nuevos cachimbos</p>

  </div>



  <div class="relative flex overflow-x-hidden group">

    <div class="flex animate-marquee whitespace-nowrap pause-group">

      {doubleIngresantes.map((alumno) => (

        <div class="inline-block mx-4 w-64 md:w-72">

          <div class="bg-white rounded-xl overflow-hidden shadow-2xl transform transition-transform duration-300 hover:scale-105">

            <div class="h-80 bg-slate-200 relative flex items-center justify-center overflow-hidden">

               <div class="absolute    bg-red-600 text-white text-[100px] font-bold px-13 py-1 rounded">

                 <img

                 src={alumno.img}/>

               </div>

               <div class="absolute top-2 right-2 bg-red-600 text-white text-[10px] font-bold px-2 py-1 rounded">

                {alumno.universidad}

               </div>

            </div>


          </div>

        </div>

      ))}

    </div>

  </div>

</section>



<style>
 

  /* Animación de desplazamiento infinito */

  @keyframes marquee {

    0% { transform: translateX(0); }

    100% { transform: translateX(-50%); }

  }



  .animate-marquee {

    display: flex;

    animation: marquee 30s linear infinite;

  }



  /* Pausar al pasar el mouse para que puedan ver bien al alumno */

  .pause-group:hover {

    animation-play-state: paused;

  }

</style>