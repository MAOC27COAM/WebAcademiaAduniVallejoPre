
---
// src/layouts/Layout.astro
import '../styles/global.css'; // <--- IMPORTANTE
import logo from '../assets/images/ico_vallejo.png'

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={logo.src} />
		<meta name="generator" content={Astro.generator} />
		<title>Academia Aduni Vallejo | Preparación Pre-universitaria Andahuaylas</title>
<meta name="description" content="La mejor academia de Andahuaylas. Ingreso directo a la UNAJMA y universidades nacionales. Estilo Cyber Dark de alto rendimiento." />
<meta name="keywords" content="Academia, Aduni Vallejo, Andahuaylas, Cachimbo, UNAJMA, Preparación" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
